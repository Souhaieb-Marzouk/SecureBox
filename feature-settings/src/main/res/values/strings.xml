    <string name="privacy_title">Privacy policy</string>
    <string name="privacy_subtitle">The short, honest version of what SecureBox does.</string>
    <string name="privacy_no_telemetry_title">No telemetry</string>
    <string name="privacy_no_telemetry_body">There are no analytics, no advertising SDKs and no crash-reporting servers. Nothing is collected about you.</string>
    <string name="privacy_on_device_title">Everything happens on your device</string>
    <string name="privacy_on_device_body">Scanning, traffic analysis and threat matching run locally. Your app list never leaves the phone or TV box.</string>
    <string name="privacy_network_title">Only two network calls</string>
    <string name="privacy_network_body">The app contacts GitHub to check for updates and, if you enable it, downloads the signed Threat Intelligence feed. Both are pull-only.</string>
    <string name="privacy_permissions_title">Permissions do one job</string>
    <string name="privacy_permissions_body">Each permission is used only for the feature named on its card. SecureBox never requests SMS, call logs or contacts.</string>
    <string name="privacy_controls_title">You stay in control</string>
    <string name="privacy_controls_body">You can disable the firewall, the feed and notifications at any time. Updates always ask before installing.</string>
    <string name="privacy_export_title">Your logs stay yours</string>
    <string name="privacy_export_body">SecureBox keeps optional diagnostic logs on the device. They are shared only if you export them yourself.</string>
