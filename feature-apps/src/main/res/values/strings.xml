    <string name="apps_how_title">How to read this</string>
    <string name="apps_how_body">Each app gets a permission score from 0 to 100. 100 means it currently has no sensitive permissions; lower means it can access more. The score uses only permissions the app has now. Risk signals are extra context and never change the score. Tap an app to see what it has and what you can change.</string>
    <string name="apps_legend">Permission score: 85–100 Safe · 70–84 Low · 50–69 Medium · 30–49 High · 0–29 Critical</string>
    <string name="apps_summary">%1$d apps · %2$d with sensitive access</string>
    <string name="apps_detail_what">What this means</string>
    <string name="apps_detail_mean_safe">No sensitive permissions are currently granted. This app cannot access messages, contacts, location, camera, microphone or screen control.</string>
    <string name="apps_detail_mean_low">A few low-risk permissions are granted. This is common and usually fine; check the list if you are unsure.</string>
    <string name="apps_detail_mean_medium">This app currently holds several sensitive permissions. Review whether it really needs each one.</string>
    <string name="apps_detail_mean_high">This app holds high-risk access such as SMS, call history, screen control, display-over-other-apps or device admin.</string>
    <string name="apps_detail_mean_critical">This app combines multiple high-risk permissions. Treat it as dangerous unless you completely trust it.</string>
    <string name="apps_detail_permissions_title">Permissions this app currently has (%1$d)</string>
    <string name="apps_detail_permissions_note">Only currently granted permissions are listed. Turn one off in Android settings, then press Refresh; the list and score update.</string>
    <string name="apps_detail_no_permissions">No sensitive permissions are currently granted. Normal permissions such as internet may still be present.</string>
    <string name="apps_recommendation_label">RECOMMENDATION</string>
    <string name="apps_recommend_system_title">Don\'t touch this app</string>
    <string name="apps_recommend_system_body">This is built-in system software. Uninstalling or changing it can break calls, Wi-Fi, updates or the launcher. If the system offers Disable and you don\'t use the app, disabling is safer than uninstalling; otherwise leave it alone.</string>
    <string name="apps_recommend_keep_title">No action needed</string>
    <string name="apps_recommend_keep_body">This app currently has no sensitive permissions granted. Leave it as it is.</string>
    <string name="apps_recommend_reduce_title">Reduce its permissions</string>
    <string name="apps_recommend_reduce_body">This app has access it may not need. Turn off the permissions below in system settings; the score and list update when you press Refresh.</string>
    <string name="apps_recommend_uninstall_title">Consider uninstalling this app</string>
    <string name="apps_recommend_uninstall_body">Its current permission set is high risk. Uninstall it if you don\'t need it. If you do, turn off the sensitive permissions below instead. SecureBox never uninstalls apps for you.</string>
    <string name="apps_recommend_short_keep">No action</string>
    <string name="apps_recommend_short_system">Leave alone</string>
    <string name="apps_recommend_short_reduce">Reduce permissions</string>
    <string name="apps_recommend_short_uninstall">Consider uninstall</string>
    <string name="apps_badge_blocked">Internet blocked</string>
    <string name="apps_badge_bypassed">VPN bypass</string>
    <string name="apps_network_title">Network access</string>
    <string name="apps_block_internet">Block internet</string>
    <string name="apps_block_internet_body">Drops this app\'s TCP connections and UDP traffic while the Local firewall is on.</string>
    <string name="apps_bypass_vpn">Bypass SecureBox VPN</string>
    <string name="apps_bypass_vpn_body">Uses the normal network outside the SecureBox tunnel. DNS filtering and the firewall do not apply to this app. Use it only for players or apps that crash inside the tunnel.</string>
