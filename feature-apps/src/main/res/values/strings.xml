    <string name="apps_how_title">How to read this</string>
    <string name="apps_how_body">Each app gets a risk score from 0 to 100. 0 means strong risk signals (red); 100 means none were found (green). A score is a prompt to review, not proof of malware. Tap an app to see the reasons and the system settings you can change.</string>
    <string name="apps_legend">85–100 Safe · 70–84 Low · 50–69 Medium · 30–49 High · 0–29 Critical</string>
    <string name="apps_summary">%1$d apps · %2$d need attention</string>
    <string name="apps_detail_what">What this means</string>
    <string name="apps_detail_mean_safe">No risk signals were found. Keep the app updated and install from the Play Store when possible.</string>
    <string name="apps_detail_mean_low">A few minor signals were found. They are common in legitimate apps, but review the list below.</string>
    <string name="apps_detail_mean_medium">Some permissions or components are worth reviewing. Check whether this app really needs them.</string>
    <string name="apps_detail_mean_high">This app can access sensitive data or control the device in ways that deserve attention. Review it now.</string>
    <string name="apps_detail_mean_critical">This app shows signals commonly used by malware or spyware. Review its permissions and consider removing it.</string>
    <string name="apps_detail_permissions_title">Permissions requested (%1$d)</string>
    <string name="apps_detail_permissions_note">The number of permissions is not a score. The most sensitive ones are listed first; Android only lets you change them in system settings.</string>
    <string name="apps_detail_no_permissions">No runtime permissions are listed for this app.</string>
