    <string name="apps_action_usage">Réglages de l\'accès à l\'usage</string>
    <string name="apps_action_admin">Réglages d\'administrateur</string>
    <string name="apps_action_note">SecureBox ne peut pas modifier directement les autorisations d\'une autre application. Ces boutons ouvrent l\'écran système exact ; désactivez l\'accès à cet endroit, ou désinstallez l\'application pour tout retirer.</string>

