<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- SecureBox stores scans, settings and firewall rules locally. None of it is backed up. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
